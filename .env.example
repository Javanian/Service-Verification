# Copy to .env and set unique values. No accounts are seeded automatically.
DB_PASSWORD=
OWNER_USERNAME=owner
# 14–72 characters; at most 72 UTF-8 bytes. Used only when no owner exists.
OWNER_PASSWORD=
# false is only for the loopback HTTP demo. Require true behind HTTPS.
COOKIE_SECURE=false
# Retained image bytes, including historical revisions.
PHOTO_JOB_MAX_BYTES=104857600
PHOTO_TOTAL_MAX_BYTES=1073741824
